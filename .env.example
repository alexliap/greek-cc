# Copy to .env and fill in. .env is gitignored.

# --- which machine is this? -------------------------------------------------
# Only relevant if this machine runs Airflow at all -- today that's just
# whichever machine runs greek_cc_manifest (the Pi), and it also hosts
# Postgres. Extraction no longer needs Airflow/Postgres/Docker; see
# "extraction" below regardless of this section.
COMPOSE_PROFILES=local-db

# Must match your host user so bind-mounted files stay writable: id -u
AIRFLOW_UID=1000

# openssl rand -hex 16
POSTGRES_PASSWORD=changeme
GREEK_CC_DB_PASSWORD=changeme

# python3 -c "import secrets, base64; print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode())"
AIRFLOW__CORE__FERNET_KEY=changeme

# Signs the JWT that task workers use to call the api-server's execution API.
# Must be shared across every service, or tokens minted by one won't verify on
# another. python3 -c "import secrets; print(secrets.token_hex(64))"
AIRFLOW__API_AUTH__JWT_SECRET=changeme

# Airflow UI login at http://localhost:8080
_AIRFLOW_WWW_USER_USERNAME=admin
_AIRFLOW_WWW_USER_PASSWORD=changeme

# --- extraction (greek-cc-extract CLI) --------------------------------------
# Needed on any machine running `uv run greek-cc-extract <crawl>` -- this is
# a plain local command, not Airflow/Docker, so it just needs these in .env
# (loaded via python-dotenv). See docs/running-on-macos.md.

# Signed S3 access to s3://commoncrawl — unlike the free HTTPS mirror this
# isn't throttled, but it does need a real AWS account and incurs data
# transfer cost since we read from outside AWS.
AWS_ACCESS_KEY_ID=changeme
AWS_SECRET_ACCESS_KEY=changeme
AWS_DEFAULT_REGION=us-east-1

# HF_TOKEN needs write access to the target repo(s).
HF_TOKEN=changeme
# greek_cc_manifest_dag.py uploads each crawl's merged manifest here once
# it's done; greek-cc-extract downloads from here. Required for extraction.
HF_MANIFEST_REPO=alexliap/greek-cc-manifests
# Optional: greek-cc-extract uploads each stage-1 chunk's (pre-dedup) survivors
# here under raw/crawl=<crawl>/chunk=<offset>/, and the final deduped output
# under crawl=<crawl>/, when set (gated -- unset it and both steps just log a
# warning and skip).
# HF_DATASET_REPO=changeme
