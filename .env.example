# Copy to .env and fill in. .env is gitignored.

# --- which machine is this? -------------------------------------------------
# Everything machine-specific lives here, so `docker compose up -d` is the same
# command everywhere. Pick ONE of the two setups below.
#
# 1. This machine runs Postgres (the default, and what the Pi does):
COMPOSE_PROFILES=local-db
#
# 2. This machine uses a Postgres running elsewhere (e.g. a Mac doing
#    extraction against the Pi's database) -- comment out COMPOSE_PROFILES
#    above and uncomment these instead. See docs/running-on-macos.md.
# COMPOSE_FILE=docker-compose.yaml:docker-compose.remote-db.yaml
# POSTGRES_HOST=192.168.1.18
# POSTGRES_PORT=5432
#
# Give this machine its own Airflow metadata database when another machine is
# already using one on that server. Two machines that each own a different DAG
# must NOT share a metadata DB: any scheduler can run any DAG it can see, so
# they'd steal each other's tasks. They still share greek_cc (below), which is
# what actually coordinates them.
# AIRFLOW_DB_NAME=airflow_mac

# Must match your host user so bind-mounted files stay writable: id -u
AIRFLOW_UID=1000

# openssl rand -hex 16
POSTGRES_PASSWORD=changeme
GREEK_CC_DB_PASSWORD=changeme

# python3 -c "import secrets, base64; print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode())"
AIRFLOW__CORE__FERNET_KEY=changeme

# Signs the JWT that task workers use to call the api-server's execution API.
# Must be shared across every service, or tokens minted by one won't verify on
# another. python3 -c "import secrets; print(secrets.token_hex(64))"
AIRFLOW__API_AUTH__JWT_SECRET=changeme

# Airflow UI login at http://localhost:8080
_AIRFLOW_WWW_USER_USERNAME=admin
_AIRFLOW_WWW_USER_PASSWORD=changeme

# Signed S3 access to s3://commoncrawl — unlike the free HTTPS mirror this
# isn't throttled, but it does need a real AWS account and incurs data
# transfer cost since we read from outside AWS.
AWS_ACCESS_KEY_ID=changeme
AWS_SECRET_ACCESS_KEY=changeme
AWS_DEFAULT_REGION=us-east-1
