# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

# Manifest output
manifests/
*.parquet

# Secrets: AWS creds, DB passwords, Airflow keys -- all one file now that the
# deployment lives in this repo rather than a sibling one
.env
nohup.out

# Airflow runtime state (bind-mounted into the containers)
airflow_logs/
airflow_auth/

# Local extraction output on the Mac (see docker-compose.mac-manifests.yaml)
/extractions/

# Database backups
backups/

# stray env backups
.env.*
!.env.example
